.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 64rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 8rpx 8rpx 24rpx;
}

.brand-mark {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #007AFF, #30B0C7);
}

.brand-text {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.title {
  color: #000000;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.subtitle {
  margin-top: 6rpx;
  color: #8e8e93;
  font-size: 22rpx;
}

.card {
  margin-bottom: 28rpx;
  padding: 30rpx 28rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.section-head {
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  color: #8e8e93;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.field {
  margin-bottom: 26rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #3c3c43;
  font-size: 26rpx;
  font-weight: 600;
}

.input,
.picker {
  height: 84rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e5e5ea;
  border-radius: 18rpx;
  background: #f7f7f9;
  color: #000000;
  font-size: 28rpx;
}

.placeholder {
  color: #aeaeb2;
}

.segmented {
  display: flex;
  padding: 6rpx;
  border-radius: 18rpx;
  background: #f2f2f7;
}

.segment {
  flex: 1;
  padding: 16rpx 4rpx;
  border-radius: 14rpx;
  color: #3c3c43;
  font-size: 26rpx;
  text-align: center;
}

.segment.active {
  background: #ffffff;
  color: #000000;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.select-row {
  display: flex;
  gap: 16rpx;
}

.picker {
  flex: 1;
  line-height: 84rpx;
}

.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  width: calc(25% - 11rpx);
  padding: 16rpx 4rpx;
  border: 1rpx solid #e5e5ea;
  border-radius: 14rpx;
  background: #ffffff;
  color: #3c3c43;
  font-size: 26rpx;
  text-align: center;
}

.chip.active {
  border-color: #007aff;
  background: #eaf3ff;
  color: #007aff;
  font-weight: 700;
}

.range-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.count-value {
  min-width: 64rpx;
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 14rpx;
  border-radius: 12rpx;
  background: #f2f2f7;
  color: #007aff;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.generate {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  border-radius: 22rpx;
  background: #007aff;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-align: center;
  box-shadow: 0 12rpx 24rpx rgba(0, 122, 255, 0.25);
}

.generate::after {
  border: none;
}

.results {
  margin-top: 12rpx;
}

.result-head {
  padding: 16rpx 8rpx 20rpx;
}

.result-title {
  display: block;
  color: #000000;
  font-size: 40rpx;
  font-weight: 800;
}

.result-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #8e8e93;
  font-size: 24rpx;
  line-height: 1.5;
}

.ref-strip {
  margin: 0 0 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #f2f2f7;
}

.ref-text {
  color: #3c3c43;
  font-size: 24rpx;
  line-height: 1.6;
}

.name-card {
  margin-bottom: 20rpx;
  padding: 26rpx 24rpx;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.05);
}

.card-top {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
}

.name-main {
  width: 100%;
  min-width: 0;
}

.name-text {
  display: block;
  color: #000000;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  line-height: 1.3;
  word-break: break-all;
}

.pinyin {
  display: block;
  margin-top: 8rpx;
  color: #007aff;
  font-size: 24rpx;
  font-weight: 700;
}

.card-actions {
  display: flex;
  flex-shrink: 0;
  justify-content: flex-end;
  gap: 8rpx;
}

.mini-button {
  width: 96rpx;
  height: 56rpx;
  line-height: 56rpx;
  margin: 0;
  padding: 0;
  border-radius: 14rpx;
  background: #f2f2f7;
  color: #007aff;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}

.mini-button::after {
  border: none;
}

.ref-line {
  display: block;
  margin-top: 16rpx;
  color: #6e6e73;
  font-size: 24rpx;
  line-height: 1.6;
}

.meaning {
  display: block;
  margin-top: 12rpx;
  color: #3c3c43;
  font-size: 26rpx;
  line-height: 1.65;
}

.insight,
.classic {
  display: block;
  margin-top: 10rpx;
  color: #8e8e93;
  font-size: 22rpx;
  line-height: 1.5;
}

.classic {
  color: #6e6e73;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.tag {
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  background: #f2f2f7;
  color: #3c3c43;
  font-size: 22rpx;
}
