.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  background:
    linear-gradient(rgba(24, 36, 48, 0.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(24, 36, 48, 0.045) 1px, transparent 1px);
  background-size: 56rpx 56rpx;
}

.header {
  position: relative;
  padding: 16rpx 8rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.brand {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-right: 62rpx;
}

.brand-mark {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  box-shadow: 0 6rpx 16rpx rgba(24, 36, 48, 0.16);
}

.brand-text {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.subtitle {
  margin-top: 8rpx;
  color: #5f6b76;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.share-top {
  position: absolute;
  top: 12rpx;
  right: 8rpx;
  width: 42rpx;
  height: 44rpx;
  line-height: 44rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: 1rpx solid #147d7a;
  border-radius: 8rpx;
  background: #eaf4f2;
  color: #0e5f5d;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
}

.share-top::after {
  border: none;
}

.panel {
  padding: 28rpx;
  border: 1rpx solid #e5ddd1;
  border-radius: 16rpx;
  background: rgba(255, 253, 248, 0.94);
  box-shadow: 0 18rpx 45rpx rgba(43, 35, 26, 0.09);
}

.field {
  margin-bottom: 26rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #5f6b76;
  font-size: 26rpx;
  font-weight: 600;
}

.input {
  height: 84rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e5ddd1;
  border-radius: 16rpx;
  background: #ffffff;
  font-size: 28rpx;
}

.placeholder {
  color: #a89b8a;
}

.segmented {
  display: flex;
  padding: 8rpx;
  border: 1rpx solid #e5ddd1;
  border-radius: 16rpx;
  background: #f1eadf;
}

.segment {
  flex: 1;
  padding: 16rpx 4rpx;
  border-radius: 12rpx;
  color: #5f6b76;
  font-size: 26rpx;
  text-align: center;
}

.segment.active {
  background: #ffffff;
  color: #182430;
  font-weight: 700;
  box-shadow: 0 2rpx 6rpx rgba(24, 36, 48, 0.12);
}

.select-row {
  display: flex;
  gap: 16rpx;
}

.picker {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e5ddd1;
  border-radius: 16rpx;
  background: #ffffff;
  font-size: 28rpx;
}

.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  width: calc(25% - 11rpx);
  padding: 16rpx 4rpx;
  border: 1rpx solid #e5ddd1;
  border-radius: 12rpx;
  background: #ffffff;
  color: #5f6b76;
  font-size: 26rpx;
  text-align: center;
}

.chip.active {
  border-color: #147d7a;
  background: #eaf4f2;
  color: #0e5f5d;
  font-weight: 700;
}

.range-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.count-value {
  min-width: 56rpx;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  background: #182430;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.generate {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #147d7a;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-align: center;
  box-shadow: 0 12rpx 24rpx rgba(20, 125, 122, 0.24);
}

.generate::after {
  border: none;
}

.results {
  margin-top: 28rpx;
}

.result-head {
  padding: 20rpx 8rpx;
}

.result-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
}

.result-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #5f6b76;
  font-size: 24rpx;
}

.ref-strip {
  margin: 8rpx 0 20rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #e8d7c5;
  border-radius: 16rpx;
  background: #fff7ef;
}

.ref-text {
  color: #8a5a32;
  font-size: 24rpx;
  line-height: 1.6;
}

.name-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #e5ddd1;
  border-radius: 16rpx;
  background: #ffffff;
}

.card-top {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
}

.name-main {
  width: 100%;
  min-width: 0;
}

.name-text {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  line-height: 1.3;
  word-break: break-all;
}

.pinyin {
  display: block;
  margin-top: 8rpx;
  color: #c6913d;
  font-size: 24rpx;
  font-weight: 700;
}

.card-actions {
  display: flex;
  flex-shrink: 0;
  justify-content: flex-end;
  gap: 8rpx;
}

.mini-button {
  width: 96rpx;
  height: 56rpx;
  line-height: 56rpx;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  background: #f1eadf;
  color: #182430;
  font-size: 24rpx;
  text-align: center;
}

.mini-button::after {
  border: none;
}

.ref-line {
  display: block;
  margin-top: 16rpx;
  color: #a05f3c;
  font-size: 24rpx;
  line-height: 1.6;
}

.meaning {
  display: block;
  margin-top: 12rpx;
  color: #5f6b76;
  font-size: 26rpx;
  line-height: 1.65;
}

.insight,
.wuge,
.classic {
  display: block;
  margin-top: 10rpx;
  color: #8b8175;
  font-size: 22rpx;
  line-height: 1.5;
}

.wuge {
  color: #7a6a5d;
}

.classic {
  color: #9a6a3f;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.tag {
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  background: #eef1ec;
  color: #4e6650;
  font-size: 22rpx;
}
