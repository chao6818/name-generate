<view class="page">
  <view class="header">
    <image class="brand-mark" src="/assets/lingming-ai-avatar-v3.png" mode="aspectFill"></image>
    <view class="brand-text">
      <text class="title">灵名</text>
      <text class="subtitle">父母姓名参考起名</text>
    </view>
  </view>

  <view class="card">
    <view class="section-head">
      <text class="section-title">基本信息</text>
    </view>

    <view class="field">
      <text class="label">父亲姓名</text>
      <input class="input" value="{{father}}" bindinput="onFatherInput" placeholder="请输入父亲姓名" placeholder-class="placeholder" />
    </view>

    <view class="field">
      <text class="label">母亲姓名</text>
      <input class="input" value="{{mother}}" bindinput="onMotherInput" placeholder="请输入母亲姓名" placeholder-class="placeholder" />
    </view>

    <view class="field">
      <text class="label">辈分用字（选填）</text>
      <input class="input" value="{{generationChar}}" maxlength="8" bindinput="onGenerationCharInput" placeholder="如：贤、承、书" placeholder-class="placeholder" />
    </view>

    <view class="field">
      <text class="label">宝宝姓氏</text>
      <view class="segmented">
        <view
          wx:for="{{surnameOptions}}"
          wx:key="value"
          class="segment {{surnameSource === item.value ? 'active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onSurnameTap"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="field">
      <text class="label">出生日期</text>
      <view class="select-row">
        <picker mode="date" value="{{birthDate}}" start="2015-01-01" end="2030-12-31" bindchange="onBirthDateChange">
          <view class="picker">{{birthDate}}</view>
        </picker>
        <picker mode="time" value="{{birthTime}}" bindchange="onBirthTimeChange">
          <view class="picker">{{birthTime}}</view>
        </picker>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-head">
      <text class="section-title">起名偏好</text>
    </view>

    <view class="field">
      <text class="label">性别倾向</text>
      <view class="segmented">
        <view
          wx:for="{{genderOptions}}"
          wx:key="value"
          class="segment {{gender === item.value ? 'active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onGenderTap"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="field">
      <text class="label">名字风格</text>
      <view class="chip-grid">
        <view
          wx:for="{{styleOptions}}"
          wx:key="id"
          class="chip {{item.active ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onStyleTap"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="field">
      <text class="label">八卦易经参考</text>
      <view class="segmented">
        <view
          class="segment {{guaEnabled ? 'active' : ''}}"
          data-value="true"
          bindtap="onGuaTap"
        >开启</view>
        <view
          class="segment {{!guaEnabled ? 'active' : ''}}"
          data-value="false"
          bindtap="onGuaTap"
        >关闭</view>
      </view>
    </view>

    <view class="field">
      <text class="label">名字长度</text>
      <view class="segmented">
        <view
          wx:for="{{lengthOptions}}"
          wx:key="value"
          class="segment {{length === item.value ? 'active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onLengthTap"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="field">
      <view class="range-head">
        <text class="label">名字数量</text>
        <text class="count-value">{{count}}</text>
      </view>
      <slider min="5" max="20" step="1" value="{{count}}" activeColor="#007AFF" backgroundColor="#E5E5EA" block-size="22" bindchange="onCountChange" />
    </view>

    <button class="generate" bindtap="onGenerate">开始取名</button>
  </view>

  <view class="results">
    <view class="result-head">
      <text class="result-title">起名结果</text>
      <text class="result-subtitle">{{subtitle}}</text>
    </view>

    <view class="ref-strip" wx:if="{{referencePrompt}}">
      <text class="ref-text">{{referencePrompt}}</text>
    </view>

    <view class="name-card" wx:for="{{names}}" wx:key="text">
      <view class="card-top">
        <view class="name-main">
          <text class="name-text">{{item.text}}</text>
          <text class="pinyin">{{item.pinyin}}</text>
        </view>
        <view class="card-actions">
          <button class="mini-button" data-index="{{index}}" catchtap="onCopy">复制</button>
          <button class="mini-button" data-index="{{index}}" catchtap="onRefresh">换</button>
        </view>
      </view>
      <text class="ref-line" wx:if="{{item.refLine}}">{{item.refLine}}</text>
      <text class="meaning">{{item.meaning}}</text>
      <text class="insight">{{item.insight}}</text>
      <text class="classic">{{item.classic}}</text>
      <view class="tags">
        <text wx:for="{{item.tagLabels}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text>
      </view>
    </view>
  </view>
</view>
